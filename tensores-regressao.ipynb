      " [[10 21 32 43]\n",
      " [14 25 36 47]\n",
      " [18 29 40 51]]\n",
      "X * coluna (broadcast nas colunas):\n",
      " [[   0    1    2    3]\n",
      " [  40   50   60   70]\n",
      " [ 800  900 1000 1100]]\n"
     ]
    }
   ],
