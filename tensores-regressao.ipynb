      "Gradiente esperado: tensor([-0.0869, -6.0304, -6.4053], grad_fn=<MvBackward0>)\n"
     ]
    }
   ],
   "source": [
    "# ToDo 6\n",
    "A = torch.randn(4, 3)\n",
    "x = torch.randn(3, requires_grad=True)\n",
    "b = torch.randn(4)\n",
    "g = torch.norm(A @ x - b, p=2) ** 2\n",
    "g.backward()\n",
    "print(f\"Gradiente calculado: {x.grad}\")\n",
    "x.detach()\n",
    "print(f\"Gradiente esperado: {2 * A.T @ (A@x-b)}\")\n"
